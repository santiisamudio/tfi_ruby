<% content_for :title, "Tabla de posiciones | Rubípticos" %>

<div class="player-module">
  <h1>Tabla de posiciones</h1>

  <ul class="tabs">
    <li>
      <%= link_to "Esta semana", leaderboard_path(tab: "week", difficulty: @difficulty),
            class: [ "tabs__item", ("tabs__item--active" if @tab == "week") ],
            aria: { current: ("page" if @tab == "week") } %>
    </li>
    <li>
      <%= link_to "Histórico", leaderboard_path(tab: "all_time", difficulty: @difficulty),
            class: [ "tabs__item", ("tabs__item--active" if @tab == "all_time") ],
            aria: { current: ("page" if @tab == "all_time") } %>
    </li>
    <li>
      <%= link_to "Mejores rachas", leaderboard_path(tab: "streaks", difficulty: @difficulty),
            class: [ "tabs__item", ("tabs__item--active" if @tab == "streaks") ],
            aria: { current: ("page" if @tab == "streaks") } %>
    </li>
  </ul>

  <% if @tab != "streaks" %>
    <div class="btn-group mt-3" role="group" aria-label="Filtrar por dificultad">
      <%= link_to "Todas", leaderboard_path(tab: @tab),
            class: [ "btn btn-sm", @difficulty.nil? ? "btn-primary" : "btn-outline-secondary" ] %>
      <%= link_to "Fácil", leaderboard_path(tab: @tab, difficulty: "facil"),
            class: [ "btn btn-sm", @difficulty == "facil" ? "btn-primary" : "btn-outline-secondary" ] %>
      <%= link_to "Medio", leaderboard_path(tab: @tab, difficulty: "medio"),
            class: [ "btn btn-sm", @difficulty == "medio" ? "btn-primary" : "btn-outline-secondary" ] %>
      <%= link_to "Avanzado", leaderboard_path(tab: @tab, difficulty: "avanzado"),
            class: [ "btn btn-sm", @difficulty == "avanzado" ? "btn-primary" : "btn-outline-secondary" ] %>
    </div>
  <% end %>

  <% if @page.total_count == 0 %>
    <% if @tab == "week" %>
      <p class="mt-4">Nadie resolvió un críptico<%= " de esa dificultad" if @difficulty %> esta semana.</p>
    <% elsif @tab == "all_time" %>
      <p class="mt-4">Nadie resolvió un críptico<%= " de esa dificultad" if @difficulty %> todavía.</p>
    <% else %>
      <p class="mt-4">Nadie tiene una racha activa todavía.</p>
    <% end %>
  <% else %>
    <div class="table-responsive">
      <table class="table leaderboard align-middle">
        <thead>
          <tr>
            <th scope="col" class="position">#</th>
            <th scope="col">Nombre</th>
            <th scope="col">Puntos</th>
            <th scope="col">Resueltos</th>
            <th scope="col">Tiempo promedio</th>
            <th scope="col">% sin pistas</th>
            <th scope="col">Racha actual</th>
            <th scope="col">Racha más alta</th>
          </tr>
        </thead>
        <tbody>
          <% @scores.each_with_index do |score, index| %>
            <%= render "leaderboards/row", score: score, position: @page.offset_value + index + 1 %>
          <% end %>
        </tbody>
        <% if @current_player_score %>
          <tfoot>
            <%= render "leaderboards/row", score: @current_player_score, position: @current_player_position %>
          </tfoot>
        <% end %>
      </table>
    </div>

    <%= paginate @page, window: 2 %>
  <% end %>
</div>
