<%= form_with model: player, url: player_path, data: { controller: "name-tiles", name_tiles_minimum_value: Player::NAME_LENGTH.min } do |form| %>
  <%= render "players/tiles", text: player.name, minimum: Player::NAME_LENGTH.min %>

  <div class="mb-4">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: ["form-control", ("is-invalid" if player.errors.any?)],
          required: true, minlength: Player::NAME_LENGTH.min, maxlength: Player::NAME_LENGTH.max,
          autofocus: true, autocomplete: "off", aria: { describedby: "name-help" },
          data: { name_tiles_target: "input", action: "name-tiles#render" } %>

    <% player.errors.full_messages.each do |message| %>
      <div class="invalid-feedback d-block"><%= message %></div>
    <% end %>

    <% suggestion = player.name_suggestion %>
    <% if suggestion %>
      <div class="suggestion">
        <span><strong><%= suggestion %></strong> está libre.</span>
        <button type="button" class="btn btn-sm btn-outline-secondary"
                data-action="name-tiles#use" data-name-tiles-name-param="<%= suggestion %>">Usar <%= suggestion %></button>
      </div>
    <% end %>

    <div id="name-help" class="form-text">
      Entre <%= Player::NAME_LENGTH.min %> y <%= Player::NAME_LENGTH.max %> caracteres, y distinto del de otro jugador aunque cambien las mayúsculas.
    </div>
  </div>

  <%= form.submit submit_label, class: "btn btn-primary" %>
<% end %>
