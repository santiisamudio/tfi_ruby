<h1>Administración de usuarios</h1>

<%= link_to "Crear usuario", new_admin_user_path %>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Rol</th>
      <th>Estado</th>
      <th>Acciones</th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.email_address %></td>
        <td>
          <%= user.admin? ? "Administrador" : "Editor de puntajes" %>
        </td>
        <td>
          <%= user.active? ? "Activo" : "Desactivado" %>
        </td>
        <td>
          <%= link_to "Editar", edit_admin_user_path(user) %>

          <% if user.active? %>
            <%= button_to "Desactivar",
                deactivate_admin_user_path(user),
                method: :patch,
                data: { turbo_confirm: "¿Desactivar este usuario?" } %>
          <% else %>
            <%= button_to "Activar",
                activate_admin_user_path(user),
                method: :patch %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>