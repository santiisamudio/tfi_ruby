<nav class="navbar navbar-expand-md bg-dark" data-bs-theme="dark">
  <div class="container">
    <%= link_to "Rubípticos", root_path, class: "navbar-brand fw-bold" %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav" aria-controls="main-nav" aria-expanded="false" aria-label="Abrir el menú">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="main-nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <%= link_to "Jugar", root_path, class: ["nav-link", ("active" if controller_name == "home")] %>
        </li>
        <li class="nav-item">
          <%= link_to "Mi racha", streak_path, class: ["nav-link", ("active" if controller_name == "streaks")] %>
        </li>
        <li class="nav-item">
          <%= link_to "Tabla de posiciones", leaderboard_path, class: ["nav-link", ("active" if controller_name == "leaderboards")] %>
        </li>
      </ul>

      <ul class="navbar-nav">
        <li class="nav-item">
          <% if current_player %>
            <%= link_to edit_player_path, class: "nav-link", title: "Tu jugador" do %>
              <i class="bi bi-person-circle"></i> <%= current_player.name %>
              <% if current_player.blocked? %><span class="badge text-bg-danger">bloqueado</span><% end %>
            <% end %>
          <% else %>
            <%= link_to new_player_path, class: "nav-link" do %>
              <i class="bi bi-person-plus"></i> Elegir nombre
            <% end %>
          <% end %>
        </li>
      </ul>
    </div>
  </div>
</nav>
